# ------------------------------------------------------------------------------
# HLS-ENGINE — Environment Variables
# Copy this file to .env and fill in real values before running docker compose up.
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# Docker / Compose
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=hls-engine

# ------------------------------------------------------------------------------
# Core runtime defaults used directly by services
# ------------------------------------------------------------------------------
SERVICE_NAME=hls-service
HTTP_PORT=8080
LOG_LEVEL=info

POSTGRES_DSN=postgres://hlsengine:change-me-postgres-secret@postgres:5432/hlsengine?sslmode=disable
POSTGRES_MAX_OPEN=25
POSTGRES_MAX_IDLE=5

REDIS_ADDR=redis:6379
REDIS_DB=0

MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_BUCKET=hls-videos

JWT_SECRET=change-me-jwt-secret-min-32-characters-long
JWT_ACCESS_TTL=24h
JWT_REFRESH_TTL=720h
JWT_SEGMENT_TTL=1h
JWT_HMAC_SECRET=change-me-signed-url-hmac-secret
API_KEY_HEADER=X-API-Key

# ------------------------------------------------------------------------------
# Object Storage (MinIO)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-secret
MINIO_BROWSER=on
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# MinIO credentials used by application services.
# For local development we reuse the root user credentials.
# In production create a dedicated service user via MinIO console / mc admin user.
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_DEFAULT_BUCKETS=uploads-raw,hls-output,thumbnails,drm-keys
MINIO_REGION=us-east-1

# ------------------------------------------------------------------------------
# Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=hlsengine
POSTGRES_PASSWORD=change-me-postgres-secret
POSTGRES_DB=hlsengine
POSTGRES_DSN=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?sslmode=disable

# ------------------------------------------------------------------------------
# Cache / PubSub (Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis-secret
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}/0

# ------------------------------------------------------------------------------
# Message Queue (RabbitMQ)
# ------------------------------------------------------------------------------
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=hlsengine
RABBITMQ_PASSWORD=change-me-rabbitmq-secret
RABBITMQ_VHOST=/
# Must exceed (CELERY_TASK_TIME_LIMIT_SEC + CELERY_ACK_TIMEOUT_MARGIN_SEC) * 1000.
# Three hours is safely above the two-hour task limit; Rabbit's 30m default is not.
RABBITMQ_CONSUMER_TIMEOUT_MS=10800000
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}

# ------------------------------------------------------------------------------
# Edge / Origin (Nginx + CDN Origin)
# ------------------------------------------------------------------------------
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
FRONTEND_HOST=frontend
FRONTEND_PORT=3000
CDN_ORIGIN_HOST=cdn-origin
CDN_ORIGIN_PORT=8080
GATEWAY_HOST=gateway
GATEWAY_PORT=8080
CACHE_PURGER_HOST=nginx-cache-purger
CACHE_PURGER_PORT=8080

# Signed URL HMAC secret — rotate in production.
SIGNED_URL_SECRET=change-me-signed-url-hmac-secret
SIGNED_URL_EXPIRY_SECONDS=3600

# Internal exact-video edge-cache revocation. Keep this endpoint private and
# replace the shared secret with an independent random value (32+ characters).
NGINX_CACHE_PURGER_URL=http://nginx-cache-purger:8080
NGINX_CACHE_PURGE_SECRET=change-me-nginx-cache-purge-secret
NGINX_CACHE_PURGE_TIMEOUT=10s
NGINX_CACHE_PURGE_MAX_HEADER_BYTES=65536
NGINX_CACHE_PURGE_BATCH_FILES=1000
NGINX_CACHE_PURGE_BATCH_DURATION=100ms
NGINX_CACHE_PURGE_BATCH_PAUSE=10ms
NGINX_CACHE_PURGE_SWEEP_INTERVAL=30s
NGINX_CACHE_PURGE_RETRY_DELAY=1s
NGINX_CACHE_PURGE_STALE_AFTER=30s

# ------------------------------------------------------------------------------
# Frontend (Next.js)
# ------------------------------------------------------------------------------
GATEWAY_URL=http://gateway:8080
CDN_ORIGIN_URL=http://cdn-origin:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_HLS_BASE_URL=http://localhost/hls
NODE_ENV=production

# ------------------------------------------------------------------------------
# Gateway (Go)
# ------------------------------------------------------------------------------
GATEWAY_ADDR=:8080
GATEWAY_LOG_LEVEL=info
GATEWAY_AUTH_SERVICE_URL=http://auth:8080
GATEWAY_UPLOAD_SERVICE_URL=http://upload:8080
GATEWAY_METADATA_SERVICE_URL=http://metadata:8080
GATEWAY_CDN_ORIGIN_URL=http://cdn-origin:8080
GATEWAY_ANALYTICS_SERVICE_URL=http://analytics:8080
GATEWAY_REDIS_URL=${REDIS_URL}
GATEWAY_RABBITMQ_URL=${RABBITMQ_URL}
GATEWAY_ALLOWED_ORIGINS=http://localhost,http://localhost:3000

# ------------------------------------------------------------------------------
# Analytics Service (Go)
# ------------------------------------------------------------------------------
ANALYTICS_PORT=8080
ANALYTICS_LOG_LEVEL=info
METRICS_PATH=/metrics
ANALYTICS_READ_TIMEOUT=5s
ANALYTICS_WRITE_TIMEOUT=10s
ANALYTICS_ROLLUP_HOURLY=5m
ANALYTICS_ROLLUP_DAILY=1h

# ------------------------------------------------------------------------------
# Auth Service (Go)
# ------------------------------------------------------------------------------
AUTH_ADDR=:8080
AUTH_LOG_LEVEL=info
AUTH_DATABASE_URL=${DATABASE_URL}
AUTH_REDIS_URL=${REDIS_URL}
AUTH_JWT_SECRET=change-me-jwt-secret-min-32-characters-long
AUTH_JWT_ISSUER=hls-engine
AUTH_JWT_ACCESS_TTL=24h
AUTH_JWT_REFRESH_TTL=720h

# ------------------------------------------------------------------------------
# Upload Service (Go)
# ------------------------------------------------------------------------------
UPLOAD_ADDR=:8080
UPLOAD_LOG_LEVEL=info
UPLOAD_DATABASE_URL=${DATABASE_URL}
UPLOAD_REDIS_URL=${REDIS_URL}
UPLOAD_RABBITMQ_URL=${RABBITMQ_URL}
UPLOAD_MAX_FILE_SIZE_BYTES=10737418240
UPLOAD_CHUNK_SIZE_BYTES=5242880
UPLOAD_RAW_BUCKET=uploads-raw
UPLOAD_MINIO_ENDPOINT=minio:9000
UPLOAD_MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
UPLOAD_MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
UPLOAD_MINIO_USE_SSL=false
UPLOAD_MINIO_REGION=${MINIO_REGION}

# ------------------------------------------------------------------------------
# Metadata Service (Go)
# ------------------------------------------------------------------------------
METADATA_ADDR=:8080
METADATA_LOG_LEVEL=info
METADATA_DATABASE_URL=${DATABASE_URL}
METADATA_REDIS_URL=${REDIS_URL}
METADATA_CACHE_TTL_SECONDS=300

# ------------------------------------------------------------------------------
# CDN Origin Service (Go)
# ------------------------------------------------------------------------------
CDN_ORIGIN_ADDR=:8080
CDN_ORIGIN_LOG_LEVEL=info
CDN_ORIGIN_REDIS_URL=${REDIS_URL}
CDN_ORIGIN_MINIO_ENDPOINT=minio:9000
CDN_ORIGIN_MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
CDN_ORIGIN_MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
CDN_ORIGIN_MINIO_USE_SSL=false
CDN_ORIGIN_MINIO_REGION=${MINIO_REGION}
CDN_ORIGIN_HLS_BUCKET=hls-output
CDN_ORIGIN_THUMBNAILS_BUCKET=thumbnails
CDN_ORIGIN_SIGNED_URL_SECRET=${SIGNED_URL_SECRET}
CDN_ORIGIN_SEGMENT_CACHE_MAX_AGE=31536000
CDN_ORIGIN_MANIFEST_CACHE_MAX_AGE=300
CDN_ORIGIN_MASTER_CACHE_MAX_AGE=60

# ------------------------------------------------------------------------------
# Transcoder API (Python + FastAPI)
# ------------------------------------------------------------------------------
APP_NAME=hls-transcoder
DEBUG=false
TRANSCODER_API_HOST=0.0.0.0
TRANSCODER_API_PORT=8080
TRANSCODER_LOG_LEVEL=info
TRANSCODER_DATABASE_URL=${DATABASE_URL}
TRANSCODER_REDIS_URL=${REDIS_URL}
TRANSCODER_RABBITMQ_URL=${RABBITMQ_URL}
TRANSCODER_CELERY_BROKER_URL=${RABBITMQ_URL}
TRANSCODER_CELERY_RESULT_BACKEND=${REDIS_URL}
TRANSCODER_MINIO_ENDPOINT=minio:9000
TRANSCODER_MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
TRANSCODER_MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
TRANSCODER_MINIO_USE_SSL=false
TRANSCODER_MINIO_REGION=${MINIO_REGION}
TRANSCODER_RAW_BUCKET=uploads-raw
TRANSCODER_HLS_BUCKET=hls-output
TRANSCODER_THUMBNAILS_BUCKET=thumbnails
RABBITMQ_EXCHANGE=hls.events
WORK_DIR=/tmp/hls-work
SEGMENT_DURATION=6
DEFAULT_RENDITIONS=360,480,720,1080
GPU_ENABLED=true
GPU_INDEX=0
NVIDIA_VISIBLE_DEVICES=all
GPU_WORKER_ID=

# ------------------------------------------------------------------------------
# Transcoder Workers (Python + Celery + FFmpeg)
# ------------------------------------------------------------------------------
TRANSCODER_WORKER_LOG_LEVEL=info
TRANSCODER_CELERY_BROKER_URL=${RABBITMQ_URL}
TRANSCODER_CELERY_RESULT_BACKEND=${REDIS_URL}
TRANSCODER_GPU_QUEUE=gpu
TRANSCODER_CPU_QUEUE=cpu
TRANSCODER_PACKAGER_QUEUE=packager
TRANSCODER_REDIS_URL=${REDIS_URL}
TRANSCODER_MINIO_ENDPOINT=minio:9000
TRANSCODER_MINIO_ACCESS_KEY=${MINIO_ACCESS_KEY}
TRANSCODER_MINIO_SECRET_KEY=${MINIO_SECRET_KEY}
TRANSCODER_MINIO_USE_SSL=false
TRANSCODER_MINIO_REGION=${MINIO_REGION}
TRANSCODER_RAW_BUCKET=uploads-raw
TRANSCODER_HLS_BUCKET=hls-output
TRANSCODER_THUMBNAILS_BUCKET=thumbnails

# ------------------------------------------------------------------------------
# Analytics Service (Node.js or Go)
# ------------------------------------------------------------------------------
ANALYTICS_ADDR=:8080
ANALYTICS_LOG_LEVEL=info
ANALYTICS_DATABASE_URL=${DATABASE_URL}
ANALYTICS_REDIS_URL=${REDIS_URL}
ANALYTICS_RABBITMQ_URL=${RABBITMQ_URL}

# ------------------------------------------------------------------------------
# Observability (Prometheus + Grafana)
# ------------------------------------------------------------------------------
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-secret

# ------------------------------------------------------------------------------
# Multi-GPU / optimization
# ------------------------------------------------------------------------------
TRANSCODER_GPU_REPLICAS=1
# One grouped task can open multiple NVENC sessions (one per rendition).
# Keep one task per GPU until the registry uses weighted, task-specific leases.
TRANSCODER_GPU_CONCURRENCY=1
NVENC_MAX_SESSIONS=2
HLS_SEGMENT_FORMAT=fmp4
VIDEO_CODEC=h264
# Single-pass encoding is the audited safe default. Keep chunking opt-in until
# retried/stale chunk tasks are fenced from overwriting another attempt.
CHUNKED_ENCODING=false
CHUNK_DURATION_SEC=60
CHUNK_MIN_DURATION_SEC=600
CPU_FALLBACK_CHUNK_DURATION_SEC=120
CPU_VIDEO_PRESET=veryfast
CPU_FALLBACK_THREADS_PER_TASK=2
GPU_FFMPEG_TIMEOUT_SEC=5400
CPU_FALLBACK_FFMPEG_TIMEOUT_SEC=5400
FFMPEG_TASK_RUNTIME_MARGIN_SEC=900
CELERY_TASK_SOFT_TIME_LIMIT_SEC=6900
CELERY_TASK_TIME_LIMIT_SEC=7200
CELERY_ACK_TIMEOUT_MARGIN_SEC=900
PER_TITLE_ENCODING=true
LOUDNORM=true
TRICKPLAY=true
TRANSCODER_METRICS_ENABLED=true
GPU_REGISTRY_ENABLED=true
FFMPEG_STALL_TIMEOUT_SEC=300
STUCK_JOB_TIMEOUT_SEC=900
STUCK_JOB_MAX_RETRIES=2
WATCHDOG_INTERVAL_SEC=300
# Failed/superseded local artifacts are reclaimed only after the job-exclusive
# lock is available and durable generation state is terminal.
WORKSPACE_REAPER_ENABLED=true
WORKSPACE_CLEANUP_GRACE_SEC=60
WORKSPACE_CLEANUP_RETRY_SEC=30
# 360 retries at 30 seconds covers a three-hour worker/hard-timeout window;
# the periodic reaper remains an unbounded restart-safe fallback.
WORKSPACE_CLEANUP_MAX_RETRIES=360
WORKSPACE_REAPER_INTERVAL_SEC=60
WORKSPACE_REAPER_SCAN_LIMIT=1000
